#!/bin/bash
#PBS -N bench-v2
#PBS -q mendels_q
#PBS -l select=1:ncpus=1:mem=8gb
#PBS -l place=free:shared
#PBS -l walltime=24:00:00
#PBS -j oe
set -e
cd "$PBS_O_WORKDIR"
export GNN_BENCH_DATA_ROOT=/rg/mendels_prj/s.sergey/data_bench
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
export PYTHONPATH="$PBS_O_WORKDIR/results/sweep-v2/source/src"
exec >"results/sweep-v2/logs/run-$PBS_ARRAY_INDEX.log" 2>&1
.venv/bin/python results/sweep-v2/source/configs/sweep_v2/run.py "$PBS_ARRAY_INDEX"
