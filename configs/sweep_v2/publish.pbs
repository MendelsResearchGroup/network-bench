#!/bin/bash
#PBS -N publish-bench-v2
#PBS -q mendels_q
#PBS -l select=1:ncpus=1:mem=4gb
#PBS -l walltime=01:00:00
#PBS -j oe
set -e
cd "$PBS_O_WORKDIR"
exec >results/sweep-v2/logs/publish.log 2>&1
export PATH=/home/alexander.z/miniconda3/bin:$PATH
export GNN_BENCH_DATA_ROOT=/rg/mendels_prj/s.sergey/data_bench
snapshot=$(.venv/bin/python -c 'import json; print(json.load(open("results/sweep-v2/snapshot.json"))["path"])')
export PYTHONPATH="$snapshot/src"
export GIT_SSH_COMMAND='ssh -o BatchMode=yes -o HostKeyAlias=github.com -p 443'
checkout=$(mktemp -d "$PBS_O_WORKDIR/results/sweep-v2/publication.XXXXXX")
git clone --depth 1 ssh://git@ssh.github.com/MendelsResearchGroup/network-bench.git "$checkout"
.venv/bin/python "$snapshot/configs/sweep_v2/export.py" "$checkout/docs"
git -C "$checkout" config user.name "$(git -C "$PBS_O_WORKDIR" config user.name)"
git -C "$checkout" config user.email "$(git -C "$PBS_O_WORKDIR" config user.email)"
cd "$checkout"
git add docs/learning-curves.json docs/results.json docs/sweep-status.json
git commit -m 'Publish detached MST and barostat sweep results'
git push origin HEAD:main
